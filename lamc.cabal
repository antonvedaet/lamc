name:           lamc
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/githubuser/lamc#readme>
homepage:       https://github.com/antonvedaet/lamc#readme
bug-reports:    https://github.com/antonvedaet/lamc/issues
author:         Anton Vedernikov
maintainer:     antonvedernikov2003@gmail.com
copyright:      2026 Anton Vedernikov
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/antonvedaet/lamc

library
  exposed-modules:
      Lib
  other-modules:
      Lambda.Named
      Lambda.Term
      Lambda.DeBruijn
      Lambda.Eval
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  default-language: Haskell2010

executable lamc-exe
  main-is: Main.hs
  other-modules:
      Paths_lamc
  autogen-modules:
      Paths_lamc
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , lamc
  default-language: Haskell2010

test-suite lamc-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_lamc
  autogen-modules:
      Paths_lamc
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , hspec
    , lamc
  default-language: Haskell2010
